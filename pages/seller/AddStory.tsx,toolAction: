import React, { useState, useEffect, useRef } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";
import { collection, addDoc, getDocs, doc, getDoc } from "firebase/firestore";
import { onAuthStateChanged } from "firebase/auth";
import { db, auth } from "../../firebase";
import { useNotify } from "../../components/Notifications";
import { uploadToImgbb } from "../../services/imgbb";
import { canAccessSellerDashboard } from "../../lib/admin";
import { triggerHaptic } from "../../lib/haptics";
import {
  X,
  Camera,
  Settings,
  Image as ImageIcon,
  Type,
  Smile,
  Sparkles,
  AtSign,
  Pencil,
  MoreHorizontal,
  ChevronDown,
  Check,
  Search,
  MapPin,
  Link as LinkIcon,
  HelpCircle,
  BarChart2,
  Clock,
  Download,
  Shield,
  MessageCircle,
  ArrowRight,
  Star,
  Users,
  Send,
  Plus,
  RotateCcw,
  Palette,
  AlignLeft,
  AlignCenter,
  AlignRight,
  CheckCircle2,
  Trash2,
  Sliders,
  Flame,
  LayoutGrid
} from "lucide-react";

// Default stock media for gallery picker matching Instagram/Meta story selector
const GALLERY_STOCK_PHOTOS = [
  "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80",
  "https://images.unsplash.com/photo-1518609878373-06d740f60d8b?auto=format&fit=crop&w=800&q=80"
];

interface CanvasElement {
  id: string;
  type: "text" | "sticker" | "location" | "mention" | "poll" | "question" | "link" | "hashtag";
  content: string;
  font?: string;
  color?: string;
  align?: "left" | "center" | "right";
  hasBg?: boolean;
  x: number; // percentage
  y: number; // percentage
  extra?: any;
}

export default function AddStory() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const fromNewsHub = searchParams.get("from") === "news-hub";
  const notify = useNotify();
  const fileInputRef = useRef<HTMLInputElement>(null);
  const drawCanvasRef = useRef<HTMLCanvasElement>(null);

  // User & Auth State
  const [userProfile, setUserProfile] = useState<any>(null);
  const [checkingAccess, setCheckingAccess] = useState(true);

  // Multi-step Flow State
  // 1: Media Picker (Gallery / Camera)
  // 2: Canvas Editor Stage
  const [currentStep, setCurrentStep] = useState<1 | 2>(1);

  // Picker & Camera Mode
  const [selectedMediaUrl, setSelectedMediaUrl] = useState<string>("");
  const [isCameraActive, setIsCameraActive] = useState(false);
  const [cameraFacing, setCameraFacing] = useState<"user" | "environment">("user");
  const [recentsCategory, setRecentsCategory] = useState<string>("Recents");
  const [showRecentsDropdown, setShowRecentsDropdown] = useState(false);
  const [customUploadedUrls, setCustomUploadedUrls] = useState<string[]>([]);
  const [isUploadingCustom, setIsUploadingCustom] = useState(false);

  // Canvas Editor State
  const [activeFilter, setActiveFilter] = useState<string>("none");
  const [elements, setElements] = useState<CanvasElement[]>([]);
  const [caption, setCaption] = useState("");
  const [isDrawingMode, setIsDrawingMode] = useState(false);
  const [brushColor, setBrushColor] = useState("#FFFFFF");
  const [isDrawing, setIsDrawing] = useState(false);

  // Active Modals State
  const [isTextStudioOpen, setIsTextStudioOpen] = useState(false);
  const [isStickerDrawerOpen, setIsStickerDrawerOpen] = useState(false);
  const [isCloseFriendsOpen, setIsCloseFriendsOpen] = useState(false);
  const [isShareSheetOpen, setIsShareSheetOpen] = useState(false);
  const [isOverflowMenuOpen, setIsOverflowMenuOpen] = useState(false);

  // Text Studio Inputs
  const [inputText, setInputText] = useState("");
  const [selectedFont, setSelectedFont] = useState<string>("Modern");
  const [textColor, setTextColor] = useState<string>("#FFFFFF");
  const [textAlign, setTextAlign] = useState<"left" | "center" | "right">("center");
  const [textHasBg, setTextHasBg] = useState(false);

  // Close Friends Selector State
  const [closeFriendsSearch, setCloseFriendsSearch] = useState("");
  const [selectedFriendIds, setSelectedFriendIds] = useState<string[]>(["friend_1", "friend_3"]);
  const mockFriends = [
    { id: "friend_1", name: "Sami Ahmed", avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" },
    { id: "friend_2", name: "Rahim Chowdhury", avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80" },
    { id: "friend_3", name: "Nabila Islam", avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=150&q=80" },
    { id: "friend_4", name: "Tanvir Hasan", avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&q=80" }
  ];

  // Overflow settings
  const [allowCommenting, setAllowCommenting] = useState(true);
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    const unsub = onAuthStateChanged(auth, async (u) => {
      if (!u) {
        setCheckingAccess(false);
        navigate("/signin", { replace: true });
        return;
      }
      try {
        const uSnap = await getDoc(doc(db, "users", u.uid));
        const uData = uSnap.exists() ? uSnap.data() : null;
        setUserProfile(
          uData
            ? { uid: u.uid, ...uData }
            : {
                uid: u.uid,
                email: u.email || "",
                displayName: u.displayName || u.email?.split("@")[0] || "Member",
                photoURL: u.photoURL || "",
              }
        );
        setCheckingAccess(false);
      } catch {
        setUserProfile({
          uid: u.uid,
          email: u.email || "",
          displayName: u.displayName || u.email?.split("@")[0] || "Member",
          photoURL: u.photoURL || "",
        });
        setCheckingAccess(false);
      }
    });

    return () => unsub();
  }, [navigate]);

  // Handle custom media file selection
  const handleCustomFileSelect = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []);
    if (files.length === 0) return;
    setIsUploadingCustom(true);
    triggerHaptic();

    try {
      const newUrls: string[] = [];
      for (const file of files) {
        if (file.type.startsWith("image/")) {
          const url = await uploadToImgbb(file);
          newUrls.push(url);
        } else if (file.type.startsWith("video/")) {
          newUrls.push(URL.createObjectURL(file));
        }
      }
      setCustomUploadedUrls((prev) => [...newUrls, ...prev]);
      if (newUrls[0]) {
        setSelectedMediaUrl(newUrls[0]);
        setCurrentStep(2);
      }
    } catch {
      notify("Failed to process media file", "error");
    } finally {
      setIsUploadingCustom(false);
      e.target.value = "";
    }
  };

  // Drawing Canvas Functions
  const startDrawing = (e: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {
    if (!isDrawingMode || !drawCanvasRef.current) return;
    setIsDrawing(true);
    const canvas = drawCanvasRef.current;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const rect = canvas.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
    const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
    
    ctx.beginPath();
    ctx.moveTo(clientX - rect.left, clientY - rect.top);
    ctx.strokeStyle = brushColor;
    ctx.lineWidth = 4;
    ctx.lineCap = "round";
  };

  const drawMove = (e: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {
    if (!isDrawing || !isDrawingMode || !drawCanvasRef.current) return;
    const canvas = drawCanvasRef.current;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const rect = canvas.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
    const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

    ctx.lineTo(clientX - rect.left, clientY - rect.top);
    ctx.stroke();
  };

  const stopDrawing = () => {
    setIsDrawing(false);
  };

  const clearDrawingCanvas = () => {
    triggerHaptic();
    if (!drawCanvasRef.current) return;
    const canvas = drawCanvasRef.current;
    const ctx = canvas.getContext("2d");
    ctx?.clearRect(0, 0, canvas.width, canvas.height);
  };

  // Canvas Overlay Handlers
  const handleAddTextElement = () => {
    if (!inputText.trim()) return;
    triggerHaptic();
    const newEl: CanvasElement = {
      id: `el_${Date.now()}`,
      type: "text",
      content: inputText.trim(),
      font: selectedFont,
      color: textColor,
      align: textAlign,
      hasBg: textHasBg,
      x: 50,
      y: 40 + elements.length * 8,
    };
    setElements((prev) => [...prev, newEl]);
    setInputText("");
    setIsTextStudioOpen(false);
  };

  const handleAddSticker = (type: CanvasElement["type"], defaultContent: string, extra?: any) => {
    triggerHaptic();
    const newEl: CanvasElement = {
      id: `sticker_${Date.now()}`,
      type,
      content: defaultContent,
      x: 50,
      y: 45 + elements.length * 6,
      extra
    };
    setElements((prev) => [...prev, newEl]);
    setIsStickerDrawerOpen(false);
  };

  const removeElement = (id: string) => {
    triggerHaptic();
    setElements((prev) => prev.filter((el) => el.id !== id));
  };

  // Filter Cycle
  const cycleFilter = () => {
    triggerHaptic();
    const filters = ["none", "brightness(1.1) contrast(1.1)", "grayscale(100%)", "sepia(80%)", "hue-rotate(180deg)"];
    const nextIdx = (filters.indexOf(activeFilter) + 1) % filters.length;
    setActiveFilter(filters[nextIdx]);
  };

  // Submit Story to Firestore
  const handlePublishStory = async () => {
    if (!selectedMediaUrl) {
      notify("Please select a photo or video first", "error");
      return;
    }

    setSubmitting(true);
    triggerHaptic();

    try {
      const currentU = auth.currentUser;
      const isSellerOrAdmin = canAccessSellerDashboard(userProfile, currentU);
      const authorName =
        userProfile?.shopName ||
        userProfile?.displayName ||
        currentU?.displayName ||
        currentU?.email?.split("@")[0] ||
        "Member";
      const authorAvatar =
        userProfile?.shopLogo ||
        userProfile?.photoURL ||
        currentU?.photoURL ||
        "";
      const nowIso = new Date().toISOString();

      const storyPayload = {
        mediaUrl: selectedMediaUrl,
        type: "image",
        category: authorName,
        caption: caption.trim(),
        elements: elements,
        filter: activeFilter,
        allowCommenting,
        userId: currentU?.uid || "",
        userName: authorName,
        userAvatar: authorAvatar,
        sellerId: currentU?.uid || "",
        sellerName: authorName,
        sellerLogo: authorAvatar,
        source: fromNewsHub || !isSellerOrAdmin ? "news_hub" : "shop",
        createdAt: nowIso,
        createdAtMs: Date.now(),
        updatedAt: nowIso,
      };

      try {
        await addDoc(collection(db, "stories"), storyPayload);
      } catch {
        const docRef = await addDoc(collection(db, "creator_videos"), {
          ...storyPayload,
          kind: "news_story",
        });
        try {
          const localStories = JSON.parse(
            localStorage.getItem("deep_news_stories_local") || "[]"
          );
          localStorage.setItem(
            "deep_news_stories_local",
            JSON.stringify([
              { id: docRef.id, ...storyPayload, kind: "news_story" },
              ...(Array.isArray(localStories) ? localStories : []),
            ])
          );
        } catch {}
      }

      notify("Story published successfully!", "success");
      navigate(fromNewsHub || !isSellerOrAdmin ? "/news-hub" : "/");
    } catch (err: any) {
      notify("Failed to publish story: " + err.message, "error");
    } finally {
      setSubmitting(false);
    }
  };

  if (checkingAccess) {
    return (
      <div className="min-h-screen bg-black text-white flex items-center justify-center">
        <div className="w-8 h-8 border-2 border-white border-t-transparent rounded-full animate-spin" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-black text-white font-sans overflow-hidden select-none relative">
      {/* Hidden File Input for Custom Uploads */}
      <input
        ref={fileInputRef}
        type="file"
        accept="image/*,video/*"
        multiple
        onChange={handleCustomFileSelect}
        className="hidden"
      />

      {/* ========================================================================= */}
      {/* STEP 1: GALLERY & CAMERA MEDIA PICKER (Matches IMG_4847 & IMG_4848)        */}
      {/* ========================================================================= */}
      {currentStep === 1 && (
        <div className="flex flex-col h-screen max-w-md mx-auto relative bg-zinc-950">
          {/* Top Header */}
          <header className="px-4 py-3.5 flex items-center justify-between border-b border-zinc-900 bg-black/90 backdrop-blur-md z-10">
            <button
              onClick={() => navigate(fromNewsHub ? "/news-hub" : "/")}
              className="w-9 h-9 rounded-full bg-zinc-900 flex items-center justify-center text-white cursor-pointer"
              aria-label="Back"
            >
              <X className="w-5 h-5" />
            </button>

            <h1 className="text-base font-bold text-white tracking-tight">
              Add to story
            </h1>

            <div className="flex items-center gap-2">
              <button
                onClick={() => {
                  triggerHaptic();
                  setIsCameraActive((c) => !c);
                }}
                className={`w-9 h-9 rounded-full flex items-center justify-center transition cursor-pointer ${
                  isCameraActive ? "bg-white text-black" : "bg-zinc-900 text-white"
                }`}
                title="Toggle Camera"
              >
                <Camera className="w-5 h-5" />
              </button>

              <button
                onClick={() => {
                  triggerHaptic();
                  fileInputRef.current?.click();
                }}
                className="w-9 h-9 rounded-full bg-zinc-900 flex items-center justify-center text-white cursor-pointer"
                title="Settings / Upload"
              >
                <Settings className="w-5 h-5" />
              </button>
            </div>
          </header>

          {/* Camera View Mode if Active */}
          {isCameraActive ? (
            <div className="flex-1 relative bg-black flex flex-col justify-between p-6">
              <div className="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/80 pointer-events-none" />

              {/* Camera Left Vertical Controls */}
              <div className="relative z-10 space-y-4 pt-4">
                <button
                  onClick={() => handleAddSticker("text", "Aa")}
                  className="w-10 h-10 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center font-serif font-bold text-lg"
                >
                  Aa
                </button>
                <button
                  onClick={() => triggerHaptic()}
                  className="w-10 h-10 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center"
                >
                  <RotateCcw className="w-5 h-5" />
                </button>
                <button
                  onClick={() => triggerHaptic()}
                  className="w-10 h-10 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center"
                >
                  <LayoutGrid className="w-5 h-5" />
                </button>
              </div>

              {/* Bottom Camera Snap Shutter */}
              <div className="relative z-10 flex items-center justify-center gap-8 pb-8">
                <button
                  onClick={() => {
                    triggerHaptic();
                    setCameraFacing((f) => (f === "user" ? "environment" : "user"));
                  }}
                  className="w-11 h-11 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center"
                >
                  <RotateCcw className="w-5 h-5" />
                </button>

                <button
                  onClick={() => {
                    triggerHaptic();
                    setSelectedMediaUrl(GALLERY_STOCK_PHOTOS[0]);
                    setIsCameraActive(false);
                    setCurrentStep(2);
                  }}
                  className="w-20 h-20 rounded-full border-4 border-white p-1 flex items-center justify-center cursor-pointer active:scale-90 transition-transform"
                >
                  <div className="w-full h-full rounded-full bg-white" />
                </button>

                <button
                  onClick={() => fileInputRef.current?.click()}
                  className="w-11 h-11 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center"
                >
                  <ImageIcon className="w-5 h-5" />
                </button>
              </div>
            </div>
          ) : (
            <div className="flex-1 overflow-y-auto space-y-4 p-3">
              {/* Top Feature Shortcut Cards */}
              <div className="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1">
                <button
                  onClick={() => {
                    triggerHaptic();
                    handleAddSticker("question", "Add yours");
                    setSelectedMediaUrl(GALLERY_STOCK_PHOTOS[0]);
                    setCurrentStep(2);
                  }}
                  className="px-4 py-3 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 flex items-center gap-2.5 shrink-0 transition cursor-pointer"
                >
                  <div className="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                    <Plus className="w-4 h-4" />
                  </div>
                  <span className="text-xs font-bold text-white">Add yours</span>
                </button>

                <button
                  onClick={() => {
                    triggerHaptic();
                    setIsStickerDrawerOpen(true);
                  }}
                  className="px-4 py-3 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 flex items-center gap-2.5 shrink-0 transition cursor-pointer"
                >
                  <div className="w-7 h-7 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center">
                    <Sparkles className="w-4 h-4" />
                  </div>
                  <span className="text-xs font-bold text-white">Stickers</span>
                </button>

                <button
                  onClick={() => {
                    triggerHaptic();
                    fileInputRef.current?.click();
                  }}
                  className="px-4 py-3 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 flex items-center gap-2.5 shrink-0 transition cursor-pointer"
                >
                  <div className="w-7 h-7 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">
                    <LayoutGrid className="w-4 h-4" />
                  </div>
                  <span className="text-xs font-bold text-white">Collage</span>
                </button>
              </div>

              {/* Category Filter Dropdown */}
              <div className="relative">
                <button
                  onClick={() => {
                    triggerHaptic();
                    setShowRecentsDropdown((s) => !s);
                  }}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-zinc-900 text-xs font-bold text-zinc-200 cursor-pointer"
                >
                  <span>{recentsCategory}</span>
                  <ChevronDown className="w-3.5 h-3.5" />
                </button>

                {showRecentsDropdown && (
                  <div className="absolute top-9 left-0 z-30 w-44 rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl py-1.5 divide-y divide-zinc-800 animate-in fade-in duration-150">
                    {["Recents", "Videos", "Favourites", "All albums", "From Meta apps"].map((cat) => (
                      <button
                        key={cat}
                        onClick={() => {
                          triggerHaptic();
                          setRecentsCategory(cat);
                          setShowRecentsDropdown(false);
                        }}
                        className={`w-full text-left px-3.5 py-2 text-xs font-semibold cursor-pointer ${
                          recentsCategory === cat ? "text-blue-400 bg-zinc-800/60" : "text-zinc-300 hover:bg-zinc-800/40"
                        }`}
                      >
                        {cat}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              {/* Photo & Video Media Grid */}
              <div className="grid grid-cols-3 gap-1.5 pb-12">
                {/* Upload Button Tile */}
                <button
                  onClick={() => fileInputRef.current?.click()}
                  className="aspect-[3/4] rounded-xl bg-zinc-900 border border-dashed border-zinc-700 flex flex-col items-center justify-center gap-1.5 text-zinc-400 hover:text-white transition cursor-pointer"
                >
                  <Plus className="w-6 h-6 text-blue-500" />
                  <span className="text-[10px] font-bold">Upload</span>
                </button>

                {/* Custom Uploaded Images First */}
                {customUploadedUrls.map((url, idx) => (
                  <div
                    key={`custom_${idx}`}
                    onClick={() => {
                      triggerHaptic();
                      setSelectedMediaUrl(url);
                      setCurrentStep(2);
                    }}
                    className="relative aspect-[3/4] rounded-xl overflow-hidden bg-zinc-900 cursor-pointer group"
                  >
                    <img src={url} className="w-full h-full object-cover group-hover:scale-105 transition-transform" alt="" />
                    <span className="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-blue-600 text-[9px] font-bold text-white">
                      Custom
                    </span>
                  </div>
                ))}

                {/* Stock Gallery Photos */}
                {GALLERY_STOCK_PHOTOS.map((url, idx) => (
                  <div
                    key={`stock_${idx}`}
                    onClick={() => {
                      triggerHaptic();
                      setSelectedMediaUrl(url);
                      setCurrentStep(2);
                    }}
                    className="relative aspect-[3/4] rounded-xl overflow-hidden bg-zinc-900 cursor-pointer group"
                  >
                    <img src={url} className="w-full h-full object-cover group-hover:scale-105 transition-transform" alt="" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {/* ========================================================================= */}
      {/* STEP 2: STORY CANVAS EDITOR STAGE (Matches IMG_4849 & IMG_4850)           */}
      {/* ========================================================================= */}
      {currentStep === 2 && (
        <div className="flex flex-col h-screen max-w-md mx-auto relative bg-black overflow-hidden">
          {/* Main 9:16 Canvas Area */}
          <div className="relative flex-1 bg-zinc-950 overflow-hidden">
            {/* Background Media with Active Filter */}
            <img
              src={selectedMediaUrl || GALLERY_STOCK_PHOTOS[0]}
              alt="Story Preview"
              style={{ filter: activeFilter }}
              className="w-full h-full object-cover"
            />

            {/* Freehand Draw Canvas Layer */}
            <canvas
              ref={drawCanvasRef}
              width={400}
              height={700}
              onMouseDown={startDrawing}
              onMouseMove={drawMove}
              onMouseUp={stopDrawing}
              onTouchStart={startDrawing}
              onTouchMove={drawMove}
              onTouchEnd={stopDrawing}
              className={`absolute inset-0 w-full h-full z-10 ${isDrawingMode ? "cursor-crosshair pointer-events-auto" : "pointer-events-none"}`}
            />

            {/* Canvas Draggable Elements Overlay */}
            <div className="absolute inset-0 z-20 pointer-events-none p-6">
              {elements.map((el) => (
                <div
                  key={el.id}
                  style={{ top: `${el.y}%`, left: `${el.x}%` }}
                  className="absolute -translate-x-1/2 -translate-y-1/2 pointer-events-auto group cursor-pointer"
                >
                  {el.type === "text" && (
                    <div
                      className={`px-3 py-1.5 rounded-xl font-bold text-lg shadow-lg ${
                        el.hasBg ? "bg-black/80 text-white" : ""
                      }`}
                      style={{
                        color: el.color || "#FFFFFF",
                        textAlign: el.align || "center",
                      }}
                    >
                      {el.content}
                    </div>
                  )}

                  {el.type === "location" && (
                    <div className="px-3.5 py-1.5 rounded-xl bg-white text-zinc-900 font-bold text-xs flex items-center gap-1.5 shadow-xl">
                      <MapPin className="w-3.5 h-3.5 text-rose-500 fill-rose-500" />
                      <span>{el.content}</span>
                    </div>
                  )}

                  {el.type === "mention" && (
                    <div className="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 text-white font-bold text-xs flex items-center gap-1 shadow-xl">
                      <AtSign className="w-3.5 h-3.5" />
                      <span>{el.content}</span>
                    </div>
                  )}

                  {el.type === "poll" && (
                    <div className="bg-white/95 text-zinc-900 rounded-2xl p-3 w-48 shadow-2xl space-y-2 border border-white">
                      <p className="text-xs font-extrabold text-center">{el.content || "Ask a question..."}</p>
                      <div className="grid grid-cols-2 gap-1.5 text-center text-xs font-bold">
                        <div className="py-1.5 bg-blue-50 text-blue-600 rounded-lg">Yes</div>
                        <div className="py-1.5 bg-rose-50 text-rose-600 rounded-lg">No</div>
                      </div>
                    </div>
                  )}

                  {el.type === "question" && (
                    <div className="bg-gradient-to-tr from-pink-500 to-rose-500 text-white rounded-2xl p-3.5 w-52 shadow-2xl text-center space-y-2">
                      <p className="text-[11px] font-bold uppercase tracking-wider opacity-90">Ask me a question</p>
                      <div className="bg-white text-zinc-400 py-2 rounded-xl text-xs font-semibold">
                        Type something...
                      </div>
                    </div>
                  )}

                  {el.type === "link" && (
                    <div className="px-3.5 py-1.5 rounded-full bg-white/90 text-blue-600 font-extrabold text-xs flex items-center gap-1.5 shadow-xl border border-white">
                      <LinkIcon className="w-3.5 h-3.5" />
                      <span>{el.content}</span>
                    </div>
                  )}

                  {el.type === "hashtag" && (
                    <div className="px-3.5 py-1.5 rounded-xl bg-blue-600 text-white font-black text-xs shadow-xl">
                      #{el.content}
                    </div>
                  )}

                  {/* Remove Button on Hover */}
                  <button
                    onClick={() => removeElement(el.id)}
                    className="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-rose-600 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                  >
                    <X className="w-3 h-3" />
                  </button>
                </div>
              ))}
            </div>

            {/* Top Bar on Canvas */}
            <div className="absolute top-4 inset-x-4 z-30 flex items-center justify-between pointer-events-auto">
              <button
                onClick={() => {
                  triggerHaptic();
                  setCurrentStep(1);
                }}
                className="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md text-white flex items-center justify-center cursor-pointer"
                aria-label="Back"
              >
                <X className="w-5 h-5" />
              </button>

              {/* Drawing Color Palette Bar if Drawing mode active */}
              {isDrawingMode && (
                <div className="flex items-center gap-1.5 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/20">
                  {["#FFFFFF", "#000000", "#EF4444", "#3B82F6", "#10B981", "#F59E0B"].map((c) => (
                    <button
                      key={c}
                      onClick={() => setBrushColor(c)}
                      className={`w-5 h-5 rounded-full border border-white/50 ${brushColor === c ? "scale-125 ring-2 ring-white" : ""}`}
                      style={{ backgroundColor: c }}
                    />
                  ))}
                  <button onClick={clearDrawingCanvas} className="ml-2 text-xs font-bold text-rose-400">
                    Clear
                  </button>
                </div>
              )}
            </div>

            {/* Vertical Right Toolbar (Matches IMG_4849) */}
            <div className="absolute top-16 right-4 z-30 flex flex-col gap-4 pointer-events-auto">
              <button
                onClick={() => {
                  triggerHaptic();
                  setIsTextStudioOpen(true);
                }}
                className="w-10 h-10 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center font-serif font-bold text-lg active:scale-90 transition cursor-pointer"
                title="Add Text"
              >
                Aa
              </button>

              <button
                onClick={() => {
                  triggerHaptic();
                  setIsStickerDrawerOpen(true);
                }}
                className="w-10 h-10 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center active:scale-90 transition cursor-pointer"
                title="Stickers"
              >
                <Smile className="w-5 h-5" />
              </button>

              <button
                onClick={cycleFilter}
                className="w-10 h-10 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center active:scale-90 transition cursor-pointer"
                title="Effects & Filters"
              >
                <Sparkles className="w-5 h-5" />
              </button>

              <button
                onClick={() => {
                  triggerHaptic();
                  const mentionUser = prompt("Enter username to mention:", "sami_deepshop");
                  if (mentionUser) handleAddSticker("mention", `@${mentionUser.replace(/^@/, "")}`);
                }}
                className="w-10 h-10 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center active:scale-90 transition cursor-pointer"
                title="Mention (@)"
              >
                <AtSign className="w-5 h-5" />
              </button>

              <button
                onClick={() => {
                  triggerHaptic();
                  setIsDrawingMode((d) => !d);
                }}
                className={`w-10 h-10 rounded-full backdrop-blur-md flex items-center justify-center active:scale-90 transition cursor-pointer ${
                  isDrawingMode ? "bg-white text-black" : "bg-black/45 text-white"
                }`}
                title="Draw"
              >
                <Pencil className="w-5 h-5" />
              </button>

              <button
                onClick={() => {
                  triggerHaptic();
                  setIsOverflowMenuOpen(true);
                }}
                className="w-10 h-10 rounded-full bg-black/45 backdrop-blur-md text-white flex items-center justify-center active:scale-90 transition cursor-pointer"
                title="More options"
              >
                <MoreHorizontal className="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Bottom Bar: Caption Input + Action Share Buttons (Matches IMG_4849) */}
          <div className="p-3 bg-black border-t border-zinc-900 space-y-2.5 z-30">
            {/* Caption Input */}
            <input
              type="text"
              value={caption}
              onChange={(e) => setCaption(e.target.value)}
              placeholder="Add a caption..."
              className="w-full h-10 px-4 rounded-full bg-zinc-900 border border-zinc-800 text-white text-xs placeholder-zinc-500 outline-none focus:border-zinc-700"
            />

            {/* Action Buttons Row */}
            <div className="flex items-center justify-between gap-2 pt-1">
              {/* Your Story Button */}
              <button
                onClick={handlePublishStory}
                disabled={submitting}
                className="flex-1 py-2.5 px-3 rounded-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold flex items-center justify-center gap-2 border border-zinc-800 cursor-pointer disabled:opacity-50"
              >
                <div className="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">
                  DS
                </div>
                <span>Your story</span>
              </button>

              {/* Close Friends Button */}
              <button
                onClick={() => {
                  triggerHaptic();
                  setIsCloseFriendsOpen(true);
                }}
                className="flex-1 py-2.5 px-3 rounded-full bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-400 text-xs font-bold flex items-center justify-center gap-1.5 border border-emerald-800/60 cursor-pointer"
              >
                <Star className="w-3.5 h-3.5 fill-emerald-400" />
                <span>Close Friends</span>
              </button>

              {/* Share Arrow Button */}
              <button
                onClick={() => {
                  triggerHaptic();
                  setIsShareSheetOpen(true);
                }}
                className="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center shadow-lg hover:bg-zinc-200 transition cursor-pointer shrink-0"
              >
                <ArrowRight className="w-5 h-5 stroke-[2.5]" />
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ========================================================================= */}
      {/* MODAL: TEXT STUDIO ("Aa") (Matches IMG_4851)                              */}
      {/* ========================================================================= */}
      {isTextStudioOpen && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex flex-col justify-between p-4 max-w-md mx-auto my-auto animate-in fade-in duration-200">
          {/* Top Controls Bar */}
          <div className="flex items-center justify-between pt-2">
            <div className="flex items-center gap-2">
              <button
                onClick={() => setTextAlign("left")}
                className={`p-2 rounded-full ${textAlign === "left" ? "bg-white text-black" : "text-white"}`}
              >
                <AlignLeft className="w-4 h-4" />
              </button>
              <button
                onClick={() => setTextAlign("center")}
                className={`p-2 rounded-full ${textAlign === "center" ? "bg-white text-black" : "text-white"}`}
              >
                <AlignCenter className="w-4 h-4" />
              </button>
              <button
                onClick={() => setTextAlign("right")}
                className={`p-2 rounded-full ${textAlign === "right" ? "bg-white text-black" : "text-white"}`}
              >
                <AlignRight className="w-4 h-4" />
              </button>
              <button
                onClick={() => setTextHasBg((b) => !b)}
                className={`px-2.5 py-1 rounded-full text-xs font-bold ${textHasBg ? "bg-white text-black" : "border border-white text-white"}`}
              >
                A=
              </button>
            </div>

            <button
              onClick={handleAddTextElement}
              className="px-5 py-1.5 rounded-full bg-white text-black font-extrabold text-xs cursor-pointer"
            >
              Done
            </button>
          </div>

          {/* Text Input Composer */}
          <div className="flex-1 flex items-center justify-center p-4">
            <textarea
              rows={3}
              value={inputText}
              onChange={(e) => setInputText(e.target.value)}
              placeholder="Type your text..."
              autoFocus
              style={{
                color: textColor,
                textAlign: textAlign,
              }}
              className={`w-full bg-transparent border-none outline-none resize-none text-2xl font-bold placeholder-white/40 ${
                textHasBg ? "p-4 rounded-2xl bg-black/60" : ""
              }`}
            />
          </div>

          {/* Bottom Toolbar: Font Switcher & Color Wheels */}
          <div className="space-y-3 pb-4">
            {/* Font Style Pills */}
            <div className="flex items-center justify-center gap-2 overflow-x-auto no-scrollbar py-1">
              {["Modern", "Classic", "Signature", "Neon", "Bold"].map((font) => (
                <button
                  key={font}
                  onClick={() => setSelectedFont(font)}
                  className={`px-3.5 py-1 rounded-full text-xs font-bold transition ${
                    selectedFont === font ? "bg-white text-black" : "bg-zinc-800 text-white"
                  }`}
                >
                  {font}
                </button>
              ))}
            </div>

            {/* Color Palette Dots */}
            <div className="flex items-center justify-center gap-3">
              {["#FFFFFF", "#000000", "#EF4444", "#EC4899", "#8B5CF6", "#3B82F6", "#10B981", "#F59E0B"].map((c) => (
                <button
                  key={c}
                  onClick={() => setTextColor(c)}
                  className={`w-7 h-7 rounded-full border-2 border-white/80 transition-transform ${
                    textColor === c ? "scale-125 ring-2 ring-blue-500" : ""
                  }`}
                  style={{ backgroundColor: c }}
                />
              ))}
            </div>
          </div>
        </div>
      )}

      {/* ========================================================================= */}
      {/* MODAL: STICKERS DRAWER (Matches IMG_4855)                                 */}
      {/* ========================================================================= */}
      {isStickerDrawerOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-end justify-center p-0 sm:p-4 animate-in fade-in duration-200">
          <div className="bg-zinc-900 w-full max-w-md h-[80vh] rounded-t-3xl p-5 flex flex-col border-t border-zinc-800 shadow-2xl">
            {/* Drawer Header with Search */}
            <div className="flex items-center justify-between gap-3 pb-3 border-b border-zinc-800 shrink-0">
              <div className="relative flex-1">
                <Search className="w-4 h-4 absolute left-3 top-3 text-zinc-400" />
                <input
                  type="text"
                  placeholder="Search"
                  className="w-full h-10 pl-9 pr-4 rounded-full bg-zinc-800 text-white text-xs placeholder-zinc-500 outline-none"
                />
              </div>

              <button
                onClick={() => setIsStickerDrawerOpen(false)}
                className="w-8 h-8 rounded-full bg-zinc-800 flex items-center justify-center text-zinc-400"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Interactive Sticker Grid */}
            <div className="flex-1 overflow-y-auto pt-4 grid grid-cols-3 sm:grid-cols-4 gap-3">
              <button
                onClick={() => {
                  const loc = prompt("Enter location name:", "Dhaka, Bangladesh");
                  if (loc) handleAddSticker("location", loc);
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <MapPin className="w-6 h-6 text-rose-500 fill-rose-500" />
                <span className="text-[11px] font-bold text-white">Location</span>
              </button>

              <button
                onClick={() => {
                  const user = prompt("Enter username:", "creator");
                  if (user) handleAddSticker("mention", `@${user}`);
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <AtSign className="w-6 h-6 text-purple-400" />
                <span className="text-[11px] font-bold text-white">Mention</span>
              </button>

              <button
                onClick={() => {
                  const q = prompt("Enter question or topic:", "Ask me anything!");
                  if (q) handleAddSticker("question", q);
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <HelpCircle className="w-6 h-6 text-pink-400" />
                <span className="text-[11px] font-bold text-white">Questions</span>
              </button>

              <button
                onClick={() => {
                  const topic = prompt("Enter poll topic:", "Which one?");
                  if (topic) handleAddSticker("poll", topic);
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <BarChart2 className="w-6 h-6 text-amber-400" />
                <span className="text-[11px] font-bold text-white">Poll</span>
              </button>

              <button
                onClick={() => {
                  const link = prompt("Enter website URL:", "https://deepshop.com");
                  if (link) handleAddSticker("link", link);
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <LinkIcon className="w-6 h-6 text-blue-400" />
                <span className="text-[11px] font-bold text-white">Link</span>
              </button>

              <button
                onClick={() => {
                  const tag = prompt("Enter hashtag:", "vibe");
                  if (tag) handleAddSticker("hashtag", tag.replace(/^#/, ""));
                }}
                className="p-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 flex flex-col items-center justify-center gap-1.5 cursor-pointer"
              >
                <span className="text-xl font-black text-[#1877F2]">#</span>
                <span className="text-[11px] font-bold text-white">Hashtag</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ========================================================================= */}
      {/* MODAL: CLOSE FRIENDS SELECTOR (Matches IMG_4852)                         */}
      {/* ========================================================================= */}
      {isCloseFriendsOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 animate-in fade-in duration-200">
          <div className="bg-zinc-900 w-full max-w-sm rounded-3xl p-5 border border-zinc-800 shadow-2xl space-y-4">
            <div className="flex items-center justify-between pb-2 border-b border-zinc-800">
              <h3 className="font-bold text-base text-white">Close Friends</h3>
              <button
                onClick={() => setIsCloseFriendsOpen(false)}
                className="p-1 rounded-full text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="relative">
              <Search className="w-4 h-4 absolute left-3 top-3 text-zinc-400" />
              <input
                type="text"
                value={closeFriendsSearch}
                onChange={(e) => setCloseFriendsSearch(e.target.value)}
                placeholder="Search friends..."
                className="w-full h-9 pl-9 pr-4 rounded-xl bg-zinc-800 text-white text-xs outline-none"
              />
            </div>

            <div className="space-y-2 max-h-60 overflow-y-auto pr-1">
              {mockFriends.map((f) => {
                const isChecked = selectedFriendIds.includes(f.id);
                return (
                  <div
                    key={f.id}
                    onClick={() => {
                      triggerHaptic();
                      setSelectedFriendIds((prev) =>
                        isChecked ? prev.filter((id) => id !== f.id) : [...prev, f.id]
                      );
                    }}
                    className="flex items-center justify-between p-2 rounded-xl hover:bg-zinc-800/70 cursor-pointer"
                  >
                    <div className="flex items-center gap-3">
                      <img src={f.avatar} className="w-9 h-9 rounded-full object-cover" alt="" />
                      <span className="text-xs font-bold text-white">{f.name}</span>
                    </div>

                    <div className={`w-5 h-5 rounded-full border flex items-center justify-center ${
                      isChecked ? "bg-emerald-500 border-emerald-500 text-white" : "border-zinc-600"
                    }`}>
                      {isChecked && <Check className="w-3.5 h-3.5 stroke-[3]" />}
                    </div>
                  </div>
                );
              })}
            </div>

            <button
              onClick={() => {
                setIsCloseFriendsOpen(false);
                notify(`Story saved for ${selectedFriendIds.length} Close Friends!`, "success");
              }}
              className="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs shadow-lg cursor-pointer"
            >
              Done ({selectedFriendIds.length})
            </button>
          </div>
        </div>
      )}

      {/* ========================================================================= */}
      {/* MODAL: SHARE BOTTOM SHEET (Matches IMG_4853)                              */}
      {/* ========================================================================= */}
      {isShareSheetOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-end justify-center p-0 sm:p-4 animate-in fade-in duration-200">
          <div className="bg-zinc-900 w-full max-w-md rounded-t-3xl p-6 border-t border-zinc-800 shadow-2xl space-y-5">
            <div className="flex items-center justify-between pb-2 border-b border-zinc-800">
              <h3 className="font-bold text-base text-white">Share story</h3>
              <button
                onClick={() => setIsShareSheetOpen(false)}
                className="p-1 text-zinc-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="space-y-3">
              <div className="flex items-center justify-between p-3.5 rounded-2xl bg-zinc-800/80 border border-zinc-800">
                <div className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs">
                    DS
                  </div>
                  <div>
                    <p className="text-xs font-bold text-white">Your story</p>
                    <p className="text-[11px] text-zinc-400">Followers and public</p>
                  </div>
                </div>
                <div className="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center">
                  <Check className="w-3.5 h-3.5 stroke-[3]" />
                </div>
              </div>

              <div className="flex items-center justify-between p-3.5 rounded-2xl bg-zinc-800/80 border border-zinc-800">
                <div className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-full bg-emerald-500 text-white flex items-center justify-center">
                    <Star className="w-4 h-4 fill-white" />
                  </div>
                  <div>
                    <p className="text-xs font-bold text-white">Close Friends</p>
                    <p className="text-[11px] text-zinc-400">{selectedFriendIds.length} people selected</p>
                  </div>
                </div>
                <button
                  onClick={() => setIsCloseFriendsOpen(true)}
                  className="px-3 py-1 rounded-full bg-zinc-700 text-[11px] font-bold text-white"
                >
                  Edit
                </button>
              </div>
            </div>

            <button
              onClick={handlePublishStory}
              disabled={submitting}
              className="w-full py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-xl transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-2"
            >
              {submitting ? "Publishing..." : "Share Story"}
            </button>
          </div>
        </div>
      )}

      {/* ========================================================================= */}
      {/* MODAL: OVERFLOW MENU (Matches IMG_4854)                                   */}
      {/* ========================================================================= */}
      {isOverflowMenuOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-end justify-center p-0 sm:p-4 animate-in fade-in duration-200">
          <div className="bg-zinc-900 w-full max-w-md rounded-t-3xl p-5 border-t border-zinc-800 shadow-2xl space-y-2">
            <button
              onClick={() => {
                triggerHaptic();
                setIsOverflowMenuOpen(false);
                notify("Story downloaded to device gallery!", "success");
              }}
              className="w-full p-3.5 rounded-2xl hover:bg-zinc-800 text-left text-xs font-bold text-white flex items-center gap-3 cursor-pointer"
            >
              <Download className="w-4 h-4 text-blue-400" />
              <span>Download</span>
            </button>

            <button
              onClick={() => {
                triggerHaptic();
                setIsOverflowMenuOpen(false);
                notify("Labeled as AI generated content", "info");
              }}
              className="w-full p-3.5 rounded-2xl hover:bg-zinc-800 text-left text-xs font-bold text-white flex items-center gap-3 cursor-pointer"
            >
              <Sparkles className="w-4 h-4 text-purple-400" />
              <span>Label AI</span>
            </button>

            <button
              onClick={() => {
                triggerHaptic();
                setAllowCommenting((c) => !c);
                setIsOverflowMenuOpen(false);
                notify(allowCommenting ? "Commenting turned off" : "Commenting enabled", "info");
              }}
              className="w-full p-3.5 rounded-2xl hover:bg-zinc-800 text-left text-xs font-bold text-white flex items-center gap-3 cursor-pointer"
            >
              <MessageCircle className="w-4 h-4 text-amber-400" />
              <span>{allowCommenting ? "Turn off commenting" : "Turn on commenting"}</span>
            </button>

            <button
              onClick={() => setIsOverflowMenuOpen(false)}
              className="w-full py-3 rounded-2xl bg-zinc-800 text-zinc-300 font-bold text-xs text-center mt-2 cursor-pointer"
            >
              Cancel
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
