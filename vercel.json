{
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.png|apple-touch-icon\\.png|llms\\.txt|robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.png" },
    { "source": "/registerSW.js", "destination": "/registerSW.js" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/workbox-(.*)", "destination": "/workbox-$1" },
    { "source": "/custom-sw.js", "destination": "/custom-sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/0f6cbbdfe0864710868cb5500f5b8e54.txt", "destination": "/0f6cbbdfe0864710868cb5500f5b8e54.txt" },
    { "source": "/api/(.*)", "destination": "/api/index?__pathname=/api/$1" },
    { "source": "/(.*)", "destination": "/api/index?__pathname=/$1" }
  ]
}
