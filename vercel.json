{
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(manifest\\.json|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/registerSW.js", "destination": "/registerSW.js" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/workbox-(.*)", "destination": "/workbox-$1" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/sitemap.xml", "destination": "/api/index?__pathname=/sitemap.xml" },
    { "source": "/api/(.*)", "destination": "/api/index?__pathname=/api/$1" },
    {
      "source": "/((?!api/|assets/|.*\\.(?:js|mjs|cjs|css|map|wasm|json|webmanifest|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|mp4|webm|mp3|wav|txt|xml)$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp|[Tt]elegram|[Tt]witter|[Dd]iscord|[Ll]inked[Ii]n|[Ss]lack|[Pp]interest|[Ss]kype|[Ee]mbedly|[Rr]eddit|[Bb]ing[Pp]review|[Ll]ighthouse|Applebot|iMessage|CFNetwork|Viber|Google-InspectionTool|curl|python).*"
        }
      ],
      "destination": "/api/index?__pathname=/$1"
    },
    {
      "source": "/((?!api/|assets/|.*\\.(?:js|mjs|cjs|css|map|wasm|json|webmanifest|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|mp4|webm|mp3|wav|txt|xml)$).*)",
      "destination": "/index.html"
    }
  ]
}
